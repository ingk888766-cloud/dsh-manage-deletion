{
  "name": "dsh-manage-deletion",
  "version": "1.2.7",
  "description": "dsh-Manage deletion｜删除会话不再靠猜：侧栏行内一键删、工作区多选批量删、全会话扫描按时间清；删除先进回收站，日志连同它写过的文件（含脚本生成的 docx/pdf）可原样还原；置顶与打开中的会话可删、运行中拒绝、默认不动会话目录外的文件；青金蓝红四色语义、零依赖、45 项测试。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "node": ">=22.19",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node --check index.js && node --check client.js && npm run test",
    "prepack": "node scripts/check-pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "cleanup",
    "trash",
    "recycle-bin"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingk888766-cloud/dsh-manage-deletion.git"
  },
  "homepage": "https://github.com/ingk888766-cloud/dsh-manage-deletion#readme",
  "bugs": {
    "url": "https://github.com/ingk888766-cloud/dsh-manage-deletion/issues"
  }
}
