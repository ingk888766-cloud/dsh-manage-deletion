{
  "name": "dsh-manage-deletion",
  "version": "1.2.8",
  "description": "删掉用不着的会话，也能找回删之前的记录和它写过的文件。侧栏会话行、工作区多选、整库扫描三个入口；删除先进回收站，按时间列出，可单条或批量还原；只带走这个会话自己写过的文件，别的文件不动；置顶和打开着的会话也能删，正在跑的不行。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "PUBLISH.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "node": ">=22.19",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node --check index.js && node --check client.js && npm run test",
    "prepack": "node scripts/check-pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "cleanup",
    "trash",
    "recycle-bin"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingk888766-cloud/dsh-manage-deletion.git"
  },
  "homepage": "https://github.com/ingk888766-cloud/dsh-manage-deletion#readme",
  "bugs": {
    "url": "https://github.com/ingk888766-cloud/dsh-manage-deletion/issues"
  }
}
